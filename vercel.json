{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://43.204.218.180:8000/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "http://43.204.218.180:8000/media/:path*"
    },
    {
      "source": "/((?!api/|media/).*)",
      "destination": "/index.html"
    }
  ]
}
